diff --git a/utils/cgroupfs-mount/files/cgroupfs-mount.init b/utils/cgroupfs-mount/files/cgroupfs-mount.init
index 0d6b68d..4ae3185 100755
--- a/utils/cgroupfs-mount/files/cgroupfs-mount.init
+++ b/utils/cgroupfs-mount/files/cgroupfs-mount.init
@@ -4,9 +4,20 @@ START=01
 
 boot() {
 	# Procd mounts non-hierarchical cgroupfs so unmount first before cgroupfs-mount
-	if mountpoint -q /sys/fs/cgroup; then
-		umount /sys/fs/cgroup/
-	fi
+	umount_cgroup() {
+		for child in /sys/fs/cgroup/*; do
+			[ -e "$child" ] || continue
+			if mountpoint -q "$child" && ! umount "$child"; then
+				echo "failed to unmount cgroup child: $child" >&2
+				return 1
+			fi
+		done
+		if mountpoint -q /sys/fs/cgroup && ! umount /sys/fs/cgroup; then
+			echo "failed to unmount cgroup root" >&2
+			return 1
+		fi
+	}
 
-	cgroupfs-mount
+	umount_cgroup || return 1
+	cgroupfs-mount
 }
