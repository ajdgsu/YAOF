From 7f6837183da98c4ec5697d9c609e7da4ce354dea Mon Sep 17 00:00:00 2001
From: sbwml <admin@cooluc.com>
Date: Wed, 23 Aug 2023 21:41:37 +0800
Subject: [PATCH] mount /sys/fs/cgroup/systemd for docker systemd support

---
 cgroupfs-mount | 17 +++++++++++++++++
 1 file changed, 17 insertions(+)

diff --git a/cgroupfs-mount b/cgroupfs-mount
index 8274c7c..4c1f954 100755
--- a/cgroupfs-mount
+++ b/cgroupfs-mount
@@ -53,3 +53,20 @@
+# Mount a named v1 hierarchy in v1 and hybrid mode, but not on pure v2.
+if awk '$0 ~ / - cgroup / { found = 1 } END { exit !found }' /proc/self/mountinfo; then
+	if ! mkdir -p /sys/fs/cgroup/systemd; then
+		echo "failed to create systemd cgroup mountpoint" >&2
+		exit 1
+	fi
+	if ! mountpoint -q /sys/fs/cgroup/systemd; then
+		if ! mount -t cgroup -o rw,nosuid,nodev,noexec,relatime,none,name=systemd systemd /sys/fs/cgroup/systemd; then
+			echo "failed to mount systemd cgroup at /sys/fs/cgroup/systemd" >&2
+			exit 1
+		fi
+	fi
+	if ! awk '$5 == "/sys/fs/cgroup/systemd" && $0 ~ / - cgroup / && $0 ~ /(^|,)name=systemd(,|$)/ { found = 1 } END { exit !found }' /proc/self/mountinfo; then
+		echo "unexpected filesystem at /sys/fs/cgroup/systemd" >&2
+		exit 1
+	fi
+fi
 # example /proc/cgroups:
 #  #subsys_name	hierarchy	num_cgroups	enabled
 #  cpuset	2	3	1
