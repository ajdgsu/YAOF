From 4cd5c39d1dfef115e81e148ceb5f821cf8a30aa7 Mon Sep 17 00:00:00 2001
From: sbwml <admin@cooluc.com>
Date: Wed, 18 Dec 2024 23:38:26 +0800
Subject: [PATCH 7/7] luci-app-firewall: add fullcone6 option for nftables
 based fullcone

Signed-off-by: sbwml <admin@cooluc.com>
---
 .../resources/view/firewall/zones.js           | 25 +++++++++++++++++++++++++
 1 file changed, 25 insertions(+)

diff --git a/applications/luci-app-firewall/htdocs/luci-static/resources/view/firewall/zones.js b/applications/luci-app-firewall/htdocs/luci-static/resources/view/firewall/zones.js
index df2f6d6..45351b3 100644
--- a/applications/luci-app-firewall/htdocs/luci-static/resources/view/firewall/zones.js
+++ b/applications/luci-app-firewall/htdocs/luci-static/resources/view/firewall/zones.js
@@ -85,6 +85,31 @@ return view.extend({
 				uci.set('firewall', section_id, 'brcmfullcone', value === '2' ? '1' : null);
 				if (wan)
 					uci.set('firewall', wan, 'fullcone4', value === '0' ? '0' : '1');
+
+				if (value !== '1') {
+					var wan = wan_zone_id();
+					if (wan)
+						uci.set('firewall', wan, 'fullcone6', '0');
+				}
+			};
+
+			/* nft-fullcone 6 */
+			o = s.option(form.RichListValue, "fullcone6", _("Full Cone NAT6"));
+			o.value('0', _("Disable"));
+			o.value('1', _("Enable"));
+			o.optional = false;
+			o.depends('fullcone_type', '1');
+			o.load = function (section_id) {
+				var wan = wan_zone_id();
+				if (!wan)
+					return '0';
+				var fullcone6 = wan ? uci.get('firewall', wan, 'fullcone6') : null;
+				return (fullcone6 === '1') ? '1' : '0';
+			};
+			o.write = function(section_id, value) {
+				var wan = wan_zone_id();
+				if (wan)
+					uci.set('firewall', wan, 'fullcone6', value === '1' ? '1' : '0');
 			};
 		}
 
