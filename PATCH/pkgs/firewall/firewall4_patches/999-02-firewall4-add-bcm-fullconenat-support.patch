 			input: [ "policy", "drop" ],
 			output: [ "policy", "drop" ],
@@ -2030,9 +2045,35 @@ return {
 
 		delete defs.syn_flood;
 
-		if (defs.fullcone == 1 && !nft_try_fullcone()) {
-			defs.fullcone = 0;
-			warn("nft_try_fullcone failed, disable fullcone globally\n");
+		if (defs.fullcone != 1) {
+			defs.brcmfullcone = 0;
+		} else if (defs.brcmfullcone != 0 && defs.brcmfullcone != 1) {
+			defs.brcmfullcone = 0;
+			this.warn_section(data, "invalid brcmfullcone value, normalized to nft_fullcone");
+		}
+
+		if (defs.fullcone != 1) {
+			/* defaults.fullcone is the authoritative global enable gate. */
+		} else if (defs.brcmfullcone == 0) {
+			if (!nft_try_fullcone()) {
+				defs.fullcone = 0;
+				this.warn_section(data, "nft_try_fullcone failed, disable fullcone globally");
+			} else {
+				this.myinfo_section(data, "nft_try_fullcone success");
+			}
+		} else if (defs.brcmfullcone == 1) {
+			if (!nft_try_brcmfullcone()) {
+				defs.brcmfullcone = 0;
+				this.warn_section(data, "nft_try_brcmfullcone failed, normalized to nft_fullcone");
+				if (!nft_try_fullcone()) {
+					defs.fullcone = 0;
+					this.warn_section(data, "nft_fullcone fallback failed, disable fullcone globally");
+				} else {
+					this.myinfo_section(data, "nft_try_fullcone fallback success");
+				}
+			} else {
+				this.myinfo_section(data, "nft_try_brcmfullcone success");
+			}
 		}
 
 		this.state.defaults = defs;
