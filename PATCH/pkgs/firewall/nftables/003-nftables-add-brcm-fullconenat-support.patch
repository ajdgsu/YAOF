From ae87b5c969b8020a229054493467b272a3f2a79d Mon Sep 17 00:00:00 2001
From: sbwml <admin@cooluc.com>
Date: Sat, 26 Oct 2024 06:06:30 +0800
Subject: [PATCH 2/2] nftables: add brcm fullconenat support

Signed-off-by: sbwml <admin@cooluc.com>
---
 include/linux/netfilter/nf_tables.h |  2 ++
 include/statement.h                 |  1 +
 src/json.c                          |  2 ++
 src/netlink_delinearize.c           |  4 ++++
 src/netlink_linearize.c             |  4 ++++
 src/parser_bison.y                  | 21 +++++++++++++++++++++
 src/parser_json.c                   |  1 +
 src/scanner.l                       |  1 +
 src/statement.c                     |  4 ++++
 9 files changed, 40 insertions(+)

--- a/include/linux/netfilter/nf_tables.h
+++ b/include/linux/netfilter/nf_tables.h
@@ -1489,12 +1489,14 @@ enum nft_tproxy_attributes {
  * @NFTA_MASQ_FLAGS: NAT flags (see NF_NAT_RANGE_* in linux/netfilter/nf_nat.h) (NLA_U32)
  * @NFTA_MASQ_REG_PROTO_MIN: source register of proto range start (NLA_U32: nft_registers)
  * @NFTA_MASQ_REG_PROTO_MAX: source register of proto range end (NLA_U32: nft_registers)
+ * @NFTA_MASQ_REG_FULLCONE: BCM fullcone NAT (NLA_U8)
  */
 enum nft_masq_attributes {
 	NFTA_MASQ_UNSPEC,
 	NFTA_MASQ_FLAGS,
 	NFTA_MASQ_REG_PROTO_MIN,
 	NFTA_MASQ_REG_PROTO_MAX,
+	NFTA_MASQ_REG_FULLCONE,
 	__NFTA_MASQ_MAX
 };
 #define NFTA_MASQ_MAX		(__NFTA_MASQ_MAX - 1)
--- a/include/statement.h
+++ b/include/statement.h
@@ -139,6 +139,7 @@ enum {
 	STMT_NAT_F_INTERVAL	= (1 << 0),
 	STMT_NAT_F_PREFIX	= (1 << 1),
 	STMT_NAT_F_CONCAT	= (1 << 2),
+	STMT_NAT_F_BRCMFULLCONE	= (1 << 3),
 };
 
 struct nat_stmt {
--- a/src/json.c
+++ b/src/json.c
@@ -1527,5 +1527,7 @@
 	if (type_flags & STMT_NAT_F_PREFIX)
 		json_array_append_new(array, json_string("prefix"));
+	if (type_flags & STMT_NAT_F_BRCMFULLCONE)
+		json_array_append_new(array, json_string("brcmfullcone"));
 
 	return array;
 }
--- a/src/netlink_delinearize.c
+++ b/src/netlink_delinearize.c
@@ -1515,6 +1515,10 @@ static void netlink_parse_masq(struct ne
 		stmt->nat.proto = proto;
 	}
 
+	if (nftnl_expr_is_set(nle, NFTNL_EXPR_MASQ_FULLCONE) &&
+	    nftnl_expr_get_u8(nle, NFTNL_EXPR_MASQ_FULLCONE))
+		stmt->nat.type_flags |= STMT_NAT_F_BRCMFULLCONE;
+
 	ctx->stmt = stmt;
 	return;
 out_err:
--- a/src/netlink_linearize.c
+++ b/src/netlink_linearize.c
@@ -1285,6 +1285,10 @@ static void netlink_gen_nat_stmt(struct
 		break;
 	}
 
+	if (stmt->nat.type == NFT_NAT_MASQ &&
+	    stmt->nat.type_flags & STMT_NAT_F_BRCMFULLCONE)
+		nftnl_expr_set_u8(nle, NFTNL_EXPR_MASQ_FULLCONE, 1);
+
 	if (stmt->nat.flags != 0)
 		nftnl_expr_set_u32(nle, nftnl_flag_attr, stmt->nat.flags);
 
--- a/src/parser_bison.y
+++ b/src/parser_bison.y
@@ -669,6 +669,7 @@ int nft_lex(void *, void *, void *);
 %token DNAT			"dnat"
 %token MASQUERADE		"masquerade"
 %token FULLCONE		"fullcone"
+%token BRCMFULLCONE		"brcmfullcone"
 %token REDIRECT			"redirect"
 %token RANDOM			"random"
 %token FULLY_RANDOM		"fully-random"
@@ -4116,6 +4117,26 @@ masq_stmt_args		:	TO 	COLON	stmt_expr
 			{
 				$<stmt>0->nat.flags = $1;
 			}
+			|	BRCMFULLCONE
+			{
+				$<stmt>0->nat.type_flags |= STMT_NAT_F_BRCMFULLCONE;
+			}
+			|	BRCMFULLCONE TO COLON stmt_expr
+			{
+				$<stmt>0->nat.type_flags |= STMT_NAT_F_BRCMFULLCONE;
+				$<stmt>0->nat.proto = $4;
+			}
+			|	BRCMFULLCONE TO COLON stmt_expr nf_nat_flags
+			{
+				$<stmt>0->nat.type_flags |= STMT_NAT_F_BRCMFULLCONE;
+				$<stmt>0->nat.proto = $4;
+				$<stmt>0->nat.flags = $5;
+			}
+			|	BRCMFULLCONE nf_nat_flags
+			{
+				$<stmt>0->nat.type_flags |= STMT_NAT_F_BRCMFULLCONE;
+				$<stmt>0->nat.flags = $2;
+			}
 			;
 
 fullcone_stmt		:	fullcone_stmt_alloc		fullcone_stmt_args
--- a/src/parser_json.c
+++ b/src/parser_json.c
@@ -2266,6 +2266,7 @@ static unsigned int json_parse_nat_type_
 		{ "interval", STMT_NAT_F_INTERVAL },
 		{ "prefix", STMT_NAT_F_PREFIX },
 		{ "concat", STMT_NAT_F_CONCAT },
+		{ "brcmfullcone", STMT_NAT_F_BRCMFULLCONE },
 	};
 	unsigned int i;
 
--- a/src/scanner.l
+++ b/src/scanner.l
@@ -471,6 +471,7 @@ addrstring	({macaddr}|{ip4addr}|{ip6addr
 "dnat"			{ scanner_push_start_cond(yyscanner, SCANSTATE_STMT_NAT); return DNAT; }
 "masquerade"		{ scanner_push_start_cond(yyscanner, SCANSTATE_STMT_NAT); return MASQUERADE; }
 "fullcone"		{ scanner_push_start_cond(yyscanner, SCANSTATE_STMT_NAT); return FULLCONE; }
+"brcmfullcone"		{ return BRCMFULLCONE; }
 "redirect"		{ scanner_push_start_cond(yyscanner, SCANSTATE_STMT_NAT); return REDIRECT; }
 "random"		{ return RANDOM; }
 <SCANSTATE_STMT_NAT>{
--- a/src/statement.c
+++ b/src/statement.c
@@ -691,6 +691,10 @@ const char *nat_etype2str(enum nft_nat_e
 static void nat_stmt_print(const struct stmt *stmt, struct output_ctx *octx)
 {
 	nft_print(octx, "%s", nat_etype2str(stmt->nat.type));
+	if (stmt->nat.type == NFT_NAT_MASQ &&
+	    stmt->nat.type_flags & STMT_NAT_F_BRCMFULLCONE) {
+		nft_print(octx, " brcmfullcone");
+	}
 	if (stmt->nat.addr || stmt->nat.proto) {
 		switch (stmt->nat.family) {
 		case NFPROTO_IPV4:
