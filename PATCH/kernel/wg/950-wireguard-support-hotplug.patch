+/*
+ *  oui-tertf Hotplug driver
+ *
+ */
+
+#include <linux/module.h>
+#include <linux/version.h>
+#include <linux/kmod.h>
+#include <linux/input.h>
+
+#include <linux/workqueue.h>
+#include <linux/skbuff.h>
+#include <linux/netlink.h>
+#include <linux/kobject.h>
+#include <linux/list.h>
+#include <linux/slab.h>
+#include <linux/string.h>
+
+#include <linux/workqueue.h>
+
+#define SUBSYSTEM_NAME	"wireguard"
+
+
+#define BH_SKB_SIZE	2048
+#define	IFNAMSIZ	16
+
+struct work_struct wg_event_work;
+struct wg_event {
+    struct list_head list;
+    char ifname[IFNAMSIZ];
+    char action[32];
+};
+static LIST_HEAD(wg_event_queue);
+static bool wg_hotplug_stopping;
+
+static DEFINE_SPINLOCK(event_lock);
+
+
+/* -------------------------------------------------------------------------*/
+static int bh_event_add_var(struct sk_buff *skb, int argv,
+                            const char *format, ...)
+{
+    static char buf[128];
+    char *s;
+    va_list args;
+    int len;
+
+    if (argv)
+        return 0;
+
+    va_start(args, format);
+    len = vsnprintf(buf, sizeof(buf), format, args);
+    va_end(args);
+
+    if (len >= sizeof(buf)) {
+        //WARN(1, "buffer size too small\n");
+        return -ENOMEM;
+    }
+
+    s = skb_put(skb, len + 1);
+    strcpy(s, buf);
+
+    return 0;
+}
+
+
+static void wireguard_send_hotplug(struct work_struct *mywork)
+{
+    struct wg_event *event;
+    struct sk_buff *skb;
+    char ifname[IFNAMSIZ];
+    char action[32];
+
+    for (;;) {
+        spin_lock_bh(&event_lock);
+        if (list_empty(&wg_event_queue)) {
+            spin_unlock_bh(&event_lock);
+            return;
+        }
+        event = list_first_entry(&wg_event_queue, struct wg_event, list);
+        list_del(&event->list);
+        strscpy(ifname, event->ifname, sizeof(ifname));
+        strscpy(action, event->action, sizeof(action));
+        spin_unlock_bh(&event_lock);
+        kfree(event);
+
+        skb = alloc_skb(BH_SKB_SIZE, GFP_KERNEL);
+        if (!skb)
+            continue;
+
+    /*pr_info("wireguard-hotplug IFNAME=%s ACTION=%s\n", ifname, action);*/
+
+        bh_event_add_var(skb, 0, "SUBSYSTEM=%s", SUBSYSTEM_NAME);
+
+        bh_event_add_var(skb, 0, "ACTION=%s", action);
+        bh_event_add_var(skb, 0, "ifname=%s", ifname);
+
+        NETLINK_CB(skb).dst_group = 1;
+        broadcast_uevent(skb, 0, 1, GFP_KERNEL);
+    }
+}
+
+void wireguard_hotplug(const char *ifname, const char *action)
+{
+    struct wg_event *event;
+    if (0 == strcmp(ifname,"wgserver"))
+	return;
+
+    event = kzalloc(sizeof(*event), GFP_ATOMIC);
+    if (!event)
+        return;
+    strscpy(event->ifname, ifname, sizeof(event->ifname));
+    strscpy(event->action, action, sizeof(event->action));
+    spin_lock_bh(&event_lock);
+    if (wg_hotplug_stopping) {
+        spin_unlock_bh(&event_lock);
+        kfree(event);
+        return;
+    }
+    list_add_tail(&event->list, &wg_event_queue);
+    schedule_work(&wg_event_work);
+    spin_unlock_bh(&event_lock);
+}
+
+void wg_hotplug_init(void)
+{
+    wg_hotplug_stopping = false;
+    INIT_WORK(&wg_event_work, wireguard_send_hotplug);
+}
+
+void wg_hotplug_free(void)
+{
+    struct wg_event *event, *tmp;
+
+    spin_lock_bh(&event_lock);
+    wg_hotplug_stopping = true;
+    spin_unlock_bh(&event_lock);
+    cancel_work_sync(&wg_event_work);
+    spin_lock_bh(&event_lock);
+    list_for_each_entry_safe(event, tmp, &wg_event_queue, list) {
+        list_del(&event->list);
+        kfree(event);
+    }
+    spin_unlock_bh(&event_lock);
+    return;
+}
--- /dev/null
+++ b/drivers/net/wireguard/hotplug.h
@@ -0,0 +1,13 @@
+#ifndef __HOTPLUG_H__
+#define __HOTPLUG_H__
+
+#define  REKEY_GIVEUP_EVENT "REKEY-GIVEUP"
